# Development-only Supabase configuration. Copy this file to .env.development.local.
# Never create this file in production and never commit it.
VMC_ENVIRONMENT=development
VMC_DEV_TEST_MODE=enabled

# The script accepts localhost by default. Set this only for a separate hosted
# development Supabase project; never point it at production.
VMC_ALLOW_REMOTE_DEVELOPMENT_SUPABASE=false

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_local_or_development_publishable_key

# Server-side provisioning only. This key must never use a NEXT_PUBLIC_ prefix.
# Use the current secret key when available. SUPABASE_SERVICE_ROLE_KEY is accepted
# as a legacy fallback for local projects that do not yet have secret keys.
SUPABASE_SECRET_KEY=your_local_or_development_secret_key

# Use unique, development-only values of at least 16 characters. Do not use
# these placeholders as passwords and do not reuse production passwords.
VMC_TEST_ADMIN_EMAIL=test.admin@vmc.test
VMC_TEST_ADMIN_PASSWORD=replace-with-a-unique-development-password
VMC_TEST_STAFF_EMAIL=test.staff@vmc.test
VMC_TEST_STAFF_PASSWORD=replace-with-a-unique-development-password
VMC_TEST_DRIVER_EMAIL=test.driver@vmc.test
VMC_TEST_DRIVER_PASSWORD=replace-with-a-unique-development-password

# Set true only when testing one driver's inability to see another driver's data.
VMC_INCLUDE_SECOND_TEST_DRIVER=false
VMC_TEST_SECOND_DRIVER_EMAIL=test.driver.two@vmc.test
VMC_TEST_SECOND_DRIVER_PASSWORD=replace-with-a-unique-development-password

# Existing test-user passwords are never changed unless this is explicitly true.
VMC_RESET_DEV_TEST_PASSWORDS=false
